/* SnowLinux のランチャー (Spotlight 風)。rofi 用。
 * 半透明の角丸の窓に、大きな検索欄と、アイコン付きの結果の一覧。選択は青いグラデーション。
 * 半透明は、ウィンドウマネージャーのコンポジットが有効なときに効く。 */

* {
  font: "Noto Sans 15";
  background-color: transparent;
  text-color: #1e1e1e;
  spacing: 0;
}

window {
  location: north;
  anchor: north;
  y-offset: 15%;
  width: 640px;
  padding: 14px;
  background-color: rgba(244, 244, 244, 96%);
  border: 1px;
  border-color: rgba(0, 0, 0, 45%);
  border-radius: 12px;
}

mainbox { children: [ inputbar, listview ]; spacing: 12px; }

inputbar {
  children: [ entry ];
  padding: 9px 14px;
  background-color: #ffffff;
  border: 1px;
  border-color: #8e8e8e;
  border-radius: 7px;
}

entry {
  placeholder: "Spotlight";
  placeholder-color: #9a9a9a;
  text-color: #1e1e1e;
}

listview {
  lines: 8;
  columns: 1;
  fixed-height: false;
  scrollbar: false;
  spacing: 2px;
  border: 0;
}

element {
  padding: 6px 10px;
  spacing: 12px;
  border-radius: 6px;
  children: [ element-icon, element-text ];
}

element-icon { size: 32px; vertical-align: 0.5; }
element-text { vertical-align: 0.5; text-color: inherit; }

element selected.normal {
  background-color: linear-gradient(to bottom, #6fa8f2, #2a63c4);
  text-color: #ffffff;
}
