#!/usr/bin/env python3
"""ソフトウェア・アップデート (Mac の「ソフトウェア・アップデート」)。

更新できるパッケージを一覧にして、「インストール」で全部を更新する。
一覧の取得は管理者の権限が要らない (今ある情報を読むだけ)。「今すぐ確認」と「インストール」だけ、
パスワードを聞く (pkexec)。MX のアップデータの代わりの入口。

使い方:
  snowlinux-software-update               窓を開く
  snowlinux-software-update --list        更新できるものを文字で出す (確認用)
"""
import os
import subprocess
import sys
import time

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib, Gtk  # noqa: E402

APT_ENV = ["env", "DEBIAN_FRONTEND=noninteractive", "LC_ALL=C"]
LISTS = "/var/lib/apt/lists"


def upgradable():
    """[(名前, 今の版, 新しい版)]。apt の既存の情報だけを使う。"""
    out = subprocess.run(["apt", "list", "--upgradable"], capture_output=True, text=True,
                         env={**os.environ, "LC_ALL": "C"}).stdout
    rows = []
    for line in out.splitlines():
        if "/" not in line or "[upgradable" not in line:
            continue
        name = line.split("/", 1)[0]
        new = line.split()[1]
        old = line.rsplit("from: ", 1)[-1].rstrip("]")
        rows.append((name, old, new))
    return rows


def last_checked():
    try:
        t = max(os.path.getmtime(os.path.join(LISTS, f)) for f in os.listdir(LISTS))
    except (OSError, ValueError):
        return "未確認"
    return time.strftime("%Y年%-m月%-d日 %H:%M", time.localtime(t))


class Updater(Gtk.Window):
    def __init__(self):
        super().__init__(title="ソフトウェア・アップデート")
        self.set_default_size(520, 420)
        self.set_icon_name("system-software-update")
        self.proc = None
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        box.set_border_width(16)
        self.add(box)

        head = Gtk.Box(spacing=14)
        icon = Gtk.Image.new_from_icon_name("system-software-update", Gtk.IconSize.DIALOG)
        icon.set_pixel_size(64)
        head.pack_start(icon, False, False, 0)
        tb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.title = Gtk.Label(xalign=0)
        self.sub = Gtk.Label(xalign=0)
        self.sub.get_style_context().add_class("dim-label")
        tb.pack_start(self.title, False, False, 0)
        tb.pack_start(self.sub, False, False, 0)
        head.pack_start(tb, True, True, 0)
        box.pack_start(head, False, False, 0)

        self.store = Gtk.ListStore(str, str, str)
        self.tree = Gtk.TreeView(model=self.store)
        for i, (t, w) in enumerate((("名前", 220), ("今の版", 120), ("新しい版", 120))):
            col = Gtk.TreeViewColumn(t, Gtk.CellRendererText(), text=i)
            col.set_min_width(w)
            col.set_resizable(True)
            self.tree.append_column(col)
        sw = Gtk.ScrolledWindow()
        sw.set_shadow_type(Gtk.ShadowType.IN)
        sw.add(self.tree)
        box.pack_start(sw, True, True, 0)

        self.log = Gtk.TextView(editable=False, cursor_visible=False, monospace=True)
        self.log_sw = Gtk.ScrolledWindow()
        self.log_sw.set_min_content_height(110)
        self.log_sw.add(self.log)
        box.pack_start(self.log_sw, False, False, 0)

        self.spin = Gtk.ProgressBar(pulse_step=0.1)
        box.pack_start(self.spin, False, False, 0)

        bar = Gtk.Box(spacing=8)
        self.check = Gtk.Button(label="今すぐ確認")
        self.check.connect("clicked", lambda *_: self.run_apt(["apt-get", "update"], "確認しています…", self.refresh))
        self.install = Gtk.Button(label="インストール")
        self.install.get_style_context().add_class("suggested-action")
        self.install.connect("clicked", self.on_install)
        bar.pack_start(self.check, False, False, 0)
        bar.pack_end(self.install, False, False, 0)
        box.pack_start(bar, False, False, 0)

        self.connect("destroy", Gtk.main_quit)
        self.show_all()
        self.log_sw.hide()
        self.spin.hide()
        self.refresh()

    def refresh(self, *_):
        self.store.clear()
        rows = upgradable()
        for r in rows:
            self.store.append(r)
        if rows:
            self.title.set_markup(f"<big><b>{len(rows)} 件のアップデートがあります</b></big>")
        else:
            self.title.set_markup("<big><b>お使いのソフトウェアは最新です</b></big>")
        self.sub.set_text("最後の確認: " + last_checked())
        self.install.set_sensitive(bool(rows))

    def on_install(self, *_):
        self.run_apt(["apt-get", "-y", "-o", "Dpkg::Options::=--force-confold", "full-upgrade"],
                     "インストールしています…", self.after_install)

    def after_install(self):
        self.refresh()
        if os.path.exists("/var/run/reboot-required"):
            self.title.set_markup("<big><b>再起動すると、更新が完了します</b></big>")

    def run_apt(self, cmd, message, done):
        if self.proc:
            return
        self.check.set_sensitive(False)
        self.install.set_sensitive(False)
        self.title.set_markup(f"<big><b>{message}</b></big>")
        self.log.get_buffer().set_text("")
        self.log_sw.show()
        self.spin.show()
        self.pulse_id = GLib.timeout_add(100, lambda: (self.spin.pulse(), True)[1])
        self.proc = Gio.Subprocess.new(["pkexec"] + APT_ENV + cmd,
                                       Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE)
        stream = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
        self.read_line(stream, done)

    def read_line(self, stream, done):
        def got(s, res):
            try:
                line, _ = s.read_line_finish_utf8(res)
            except GLib.Error:
                line = None
            if line is None:
                self.proc.wait_async(None, lambda p, r: self.finished(done))
                return
            buf = self.log.get_buffer()
            buf.insert(buf.get_end_iter(), line + "\n")
            self.log.scroll_to_mark(buf.get_insert(), 0, False, 0, 0)
            self.read_line(s, done)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got)

    def finished(self, done):
        ok = self.proc.get_exit_status() == 0
        self.proc = None
        GLib.source_remove(self.pulse_id)
        self.spin.hide()
        self.check.set_sensitive(True)
        done()
        if not ok:
            self.title.set_markup("<big><b>完了できませんでした</b></big>")
            self.sub.set_text("パスワードの入力をやめたか、更新でエラーが出ました。下の記録を見てください。")


def main():
    if "--list" in sys.argv:
        for r in upgradable():
            print(*r, sep="\t")
        print("最後の確認:", last_checked())
        return
    Updater()
    Gtk.main()


main()
